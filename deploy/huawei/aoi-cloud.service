[Unit]
Description=Loongson AOI v1.0.0 cloud detection backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Loongson_AOI_PCB/cloud-backend
EnvironmentFile=/root/Loongson_AOI_PCB/cloud-backend/.env
ExecStart=/root/Loongson_AOI_PCB/cloud-backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
